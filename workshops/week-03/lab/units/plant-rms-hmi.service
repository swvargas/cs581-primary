[Unit]
Description=CS581 RMS HMI
After=network.target plant-rms.service
Requires=plant-rms.service

[Service]
Type=simple
WorkingDirectory=%h/lab
EnvironmentFile=%h/lab/.env
ExecStart=%h/lab/.venv/bin/gunicorn -w 2 -b 127.0.0.1:5060 hmi.app:app
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
